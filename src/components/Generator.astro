---
import { SITE } from '../config';

const fieldClass =
  'w-full rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm shadow-xs placeholder:text-ink-400 focus:border-brand-500';
const labelClass = 'mb-1.5 block text-sm font-medium text-ink-800';
const hintClass = 'mt-1 text-xs text-ink-400';
---

<section
  id="generator"
  data-origin={SITE.url}
  class="mx-auto grid max-w-6xl gap-8 px-5 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]"
>
  <!-- ---------- form ---------- -->
  <form id="atc-form" novalidate class="rounded-2xl border border-ink-200 bg-white p-5 sm:p-6">
    <h2 class="text-lg font-semibold tracking-tight">Event details</h2>
    <p class="mt-1 text-sm text-ink-600">
      Nothing is stored. Everything below is turned into links in your browser.
    </p>

    <div class="mt-6 space-y-5">
      <div>
        <label class={labelClass} for="f-title">Event title <span class="text-brand-600">*</span></label>
        <input
          id="f-title"
          name="title"
          class={fieldClass}
          required
          maxlength="200"
          placeholder="Q4 product webinar"
          autocomplete="off"
        />
        <p class="mt-1 hidden text-xs text-red-600" data-error-for="title">Give the event a title.</p>
      </div>

      <label class="flex items-center gap-2.5 text-sm font-medium text-ink-800">
        <input id="f-allday" name="allDay" type="checkbox" class="h-4 w-4 rounded border-ink-200" />
        All-day event
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={labelClass} for="f-start-date">Starts <span class="text-brand-600">*</span></label>
          <div class="flex gap-2">
            <input id="f-start-date" name="startDate" type="date" class={fieldClass} required />
            <input id="f-start-time" name="startTime" type="time" class={`${fieldClass} max-w-32`} value="14:00" />
          </div>
          <p class="mt-1 hidden text-xs text-red-600" data-error-for="start">Pick a start date.</p>
        </div>
        <div>
          <label class={labelClass} for="f-end-date">Ends</label>
          <div class="flex gap-2">
            <input id="f-end-date" name="endDate" type="date" class={fieldClass} />
            <input id="f-end-time" name="endTime" type="time" class={`${fieldClass} max-w-32`} value="15:00" />
          </div>
          <p class="mt-1 hidden text-xs text-red-600" data-error-for="end">
            The end is before the start.
          </p>
        </div>
      </div>

      <div>
        <label class={labelClass} for="f-timezone">Timezone</label>
        <select id="f-timezone" name="timeZone" class={fieldClass}></select>
        <p class={hintClass}>
          The times above are read in this zone. Every calendar then shows the event correctly for
          its own owner.
        </p>
      </div>

      <div>
        <label class={labelClass} for="f-location">Location or meeting link</label>
        <input
          id="f-location"
          name="location"
          class={fieldClass}
          maxlength="300"
          placeholder="https://meet.google.com/abc-defg-hij"
        />
      </div>

      <div>
        <label class={labelClass} for="f-description">Description</label>
        <textarea
          id="f-description"
          name="description"
          rows="3"
          maxlength="2000"
          class={fieldClass}
          placeholder="What the event is about, joining instructions, agenda."></textarea>
      </div>

      <details class="rounded-lg border border-ink-100 bg-ink-50/60 px-4 py-3">
        <summary class="cursor-pointer text-sm font-medium text-ink-800">More options</summary>
        <div class="mt-4 space-y-5">
          <div>
            <label class={labelClass} for="f-url">Event page URL</label>
            <input id="f-url" name="url" class={fieldClass} placeholder="https://example.com/webinar" />
            <p class={hintClass}>Added to the description, since not every calendar has a URL field.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="f-repeat">Repeats</label>
              <select id="f-repeat" name="repeat" class={fieldClass}>
                <option value="">Does not repeat</option>
                <option value="FREQ=DAILY">Every day</option>
                <option value="FREQ=WEEKLY">Every week</option>
                <option value="FREQ=WEEKLY;INTERVAL=2">Every 2 weeks</option>
                <option value="FREQ=MONTHLY">Every month</option>
                <option value="FREQ=YEARLY">Every year</option>
              </select>
            </div>
            <div>
              <label class={labelClass} for="f-count">Number of times</label>
              <input
                id="f-count"
                name="repeatCount"
                type="number"
                min="2"
                max="500"
                class={fieldClass}
                placeholder="Unlimited"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="f-reminder">Reminder (.ics only)</label>
              <select id="f-reminder" name="reminderMinutes" class={fieldClass}>
                <option value="">No reminder</option>
                <option value="10">10 minutes before</option>
                <option value="30">30 minutes before</option>
                <option value="60">1 hour before</option>
                <option value="1440">1 day before</option>
              </select>
            </div>
            <div>
              <label class={labelClass} for="f-organizer">Organiser email (.ics only)</label>
              <input id="f-organizer" name="organizerEmail" type="email" class={fieldClass} placeholder="you@example.com" />
            </div>
          </div>

          <label class="flex items-start gap-2.5 text-sm text-ink-800">
            <input id="f-track" name="track" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-ink-200" />
            <span>
              <span class="font-medium">Count clicks</span>
              <span class="block text-xs text-ink-400">
                Links pass through {SITE.name} first so you can see how many people added the event,
                per calendar. No cookies, no personal data.
              </span>
            </span>
          </label>
        </div>
      </details>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-ink-100 pt-5">
      <!-- min-h-11 keeps tap targets at 44px, which is what mobile audits want. -->
      <button
        type="submit"
        class="min-h-11 rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700"
        >Generate links</button
      >
      <button
        type="button"
        id="atc-example"
        class="min-h-11 rounded-lg border border-ink-200 px-5 py-3 text-sm font-medium text-ink-800 hover:bg-ink-50"
        >Fill in an example</button
      >
      <button
        type="reset"
        class="ml-auto inline-flex min-h-11 items-center px-2 text-sm text-ink-400 underline-offset-2 hover:text-ink-800 hover:underline"
        >Reset</button
      >
    </div>
  </form>

  <!-- ---------- output ---------- -->
  <div id="atc-output" class="lg:sticky lg:top-6 lg:self-start">
    <div
      id="atc-empty"
      class="rounded-2xl border border-dashed border-ink-200 bg-ink-50/50 p-10 text-center"
    >
      <p class="text-sm font-medium text-ink-800">Your links appear here</p>
      <p class="mx-auto mt-1 max-w-xs text-sm text-ink-400">
        Fill in a title and a start date, then hit generate. Everything happens in your browser.
      </p>
    </div>

    <div id="atc-result" hidden class="space-y-5">
      <div class="rounded-2xl border border-ink-200 bg-white p-5 sm:p-6">
        <h2 class="text-lg font-semibold tracking-tight">Preview</h2>
        <p class="mt-1 text-sm text-ink-600">Click a button to test it with your own calendar.</p>
        <div id="atc-preview" class="mt-4 flex flex-wrap gap-2"></div>
        <p id="atc-summary" class="mt-4 border-t border-ink-100 pt-4 text-sm text-ink-600"></p>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Output format">
          <button data-tab="html" class="atc-tab" role="tab">HTML snippet</button>
          <button data-tab="widget" class="atc-tab" role="tab">Widget</button>
          <button data-tab="urls" class="atc-tab" role="tab">Plain URLs</button>
          <button data-tab="markdown" class="atc-tab" role="tab">Markdown</button>
        </div>

        <p id="atc-tab-hint" class="mt-4 text-sm text-ink-600"></p>

        <div class="relative mt-3">
          <pre
            class="max-h-80 overflow-auto rounded-xl bg-ink-900 p-4 pr-24 text-xs leading-relaxed text-ink-100"><code id="atc-code"></code></pre>
          <button
            id="atc-copy"
            type="button"
            class="absolute right-3 top-3 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-medium text-white backdrop-blur hover:bg-white/20"
            >Copy</button
          >
        </div>
      </div>

      <div
        id="atc-stats-box"
        hidden
        class="rounded-2xl border border-brand-100 bg-brand-50 p-5 text-sm sm:p-6"
      >
        <p class="font-semibold text-ink-900">Your click dashboard</p>
        <p class="mt-1 text-ink-600">
          Bookmark this. It shows how many people added your event, split per calendar.
        </p>
        <a
          id="atc-stats-link"
          class="mt-3 inline-block break-all font-mono text-xs text-brand-700 underline"
          target="_blank"
          rel="noopener"></a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/generator';
</script>
