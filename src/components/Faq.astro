---
export interface Props {
  items: { q: string; a: string }[];
  title?: string;
}

const { items, title = 'Frequently asked questions' } = Astro.props;
---

<section class="mx-auto max-w-3xl px-5 py-14">
  <h2 class="text-2xl font-bold tracking-tight">{title}</h2>
  <div class="mt-6 divide-y divide-ink-100 rounded-2xl border border-ink-200 bg-white">
    {
      items.map((item) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-ink-900">
            {item.q}
            <span class="text-ink-400 transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 text-sm leading-relaxed text-ink-600" set:html={item.a} />
        </details>
      ))
    }
  </div>
</section>
