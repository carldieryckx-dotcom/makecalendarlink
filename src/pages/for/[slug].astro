---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { USE_CASES } from '../../data/use-cases';
import { GUIDES } from '../../data/guides';
import { SITE } from '../../config';

export function getStaticPaths() {
  return USE_CASES.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }));
}

const { useCase } = Astro.props;
const others = USE_CASES.filter((u) => u.slug !== useCase.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: useCase.title,
    description: useCase.description,
    url: `${SITE.url}/for/${useCase.slug}`,
    publisher: { '@type': 'Organization', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: useCase.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<Base
  title={useCase.title}
  description={useCase.description}
  path={`/for/${useCase.slug}`}
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <nav class="text-sm text-ink-400">
      <a href="/" class="hover:text-ink-800">Home</a>
      <span class="mx-2">/</span>
      <a href="/how-to" class="hover:text-ink-800">Guides</a>
    </nav>

    <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{useCase.h1}</h1>
    <p class="mt-4 text-lg text-ink-600" set:html={useCase.intro} />

    <div class="prose-page mt-2">
      {
        useCase.sections.map((section) => (
          <section>
            <h2>{section.h2}</h2>
            <div set:html={section.html} />
          </section>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-brand-100 bg-brand-50 p-6">
      <h2 class="font-semibold">Make your links</h2>
      <p class="mt-1 text-sm text-ink-600">
        Free, no account, and the HTML snippet is ready to paste.
      </p>
      <a
        href="/#generator"
        class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
        >Open the generator</a
      >
    </div>
  </article>

  <Faq items={useCase.faq} title="Questions" />

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="text-lg font-semibold tracking-tight">Keep reading</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        [...others, ...GUIDES.slice(0, 2)].map((item) => (
          <a
            href={'sections' in item && 'keyword' in item ? `/how-to/${item.slug}` : `/for/${item.slug}`}
            class="rounded-xl border border-ink-200 bg-white p-4 hover:border-brand-500"
          >
            <span class="text-sm font-semibold">{item.h1}</span>
            <span class="mt-1 block text-sm text-ink-600">{item.blurb}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
