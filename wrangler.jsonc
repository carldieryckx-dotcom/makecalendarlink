{
  // Cloudflare Workers configuration.
  //
  // The site deploys fine without the D1 database below: it is only needed for
  // click counting. Ship first, add the numbers when you want them.
  //
  //   npx wrangler d1 create calendarbutton     -> paste the id it prints
  //   npm run db:migrate                      -> create the tables
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendarbutton",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendarbutton",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
